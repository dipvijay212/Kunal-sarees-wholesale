# Public URL of the deployed site. Used for canonical URLs, the sitemap,
# Open Graph tags and product links inside WhatsApp messages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number in international format, digits only (country code + number).
NEXT_PUBLIC_WHATSAPP_NUMBER=919913238496

# Backend REST API endpoint URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api
